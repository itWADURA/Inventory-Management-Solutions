# Environment configuration for Itwadura Inventory
# Copy this file to .env and adjust variables as required.

# Django Security
DEBUG=True
SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production
ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Database Configuration
# Leave DB_ENGINE empty or 'sqlite' for quick local development using SQLite.
# For production and multi-user Docker setups, set to 'postgresql'.
DB_ENGINE=sqlite
DB_NAME=itwadura_inventory
DB_USER=itwadura_user
DB_PASSWORD=replace_with_strong_password
DB_HOST=127.0.0.1
DB_PORT=5432

# Production Security Flags
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False

# Email Configuration (optional, default console in debug)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=inventory@example.com

